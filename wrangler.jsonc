{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyanflash",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/dash", "/dash/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "nyanflash", "database_id": "10f3fdb0-06cd-47f8-b4a2-3cdfd5d46ce6" }
  ]
}
